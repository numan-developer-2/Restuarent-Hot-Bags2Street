# Next.js frontend server route configuration
# Set this in Vercel Project Settings -> Environment Variables.

# Cloudflare Tunnel HTTPS URL that points to the local FastAPI backend.
# Example: https://hot-bagels-demo.trycloudflare.com
HOT_BAGELS_BRAIN_URL=

# Optional alias supported by the API proxy routes.
BACKEND_PUBLIC_URL=

# Optional timeout for long local STT/TTS responses.
HOT_BAGELS_BRAIN_TIMEOUT_MS=180000

